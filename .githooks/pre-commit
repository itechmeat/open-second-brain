#!/usr/bin/env bash
# Pre-commit gate: never commit unformatted or lint-erroring code.
# Enabled via `git config core.hooksPath .githooks` (wired by the package
# `prepare` script on `bun install`, or `bun run hooks:install`).
#
# This is a fast local guard, not the source of truth - CI's required
# `validate` check enforces the same on every PR. Bypass in a pinch with
# `git commit --no-verify`.
set -euo pipefail

# Check the working tree git is committing from. Git starts a hook at the
# root of that tree, and `--show-toplevel` names it - a linked worktree
# included. Deriving the root from this script's own path instead sent a
# commit made in a worktree to the main checkout whenever core.hooksPath
# was set to an absolute path, and the checks then ran against the wrong
# tree. The script-relative root stays as the fallback outside git.
if REPO=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$REPO" ]; then
  :
else
  SELF=$(realpath -- "${BASH_SOURCE[0]}")
  REPO=$(cd -- "$(dirname -- "$SELF")/.." && pwd)
fi
cd -- "$REPO"

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not on PATH; skipping fmt/lint checks" >&2
  exit 0
fi

echo "pre-commit: bun run fmt:check" >&2
if ! bun run fmt:check; then
  echo "pre-commit: formatting check failed - run 'bun run fmt' and re-stage." >&2
  exit 1
fi

echo "pre-commit: bun run sync-plugin-mirrors:check" >&2
if ! bun run sync-plugin-mirrors:check; then
  echo "pre-commit: plugins/codex mirrors drifted - run 'bun run sync-plugin-mirrors' and re-stage." >&2
  exit 1
fi

echo "pre-commit: bun run lint" >&2
bun run lint
