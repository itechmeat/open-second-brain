{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.feature_area.v1",
  "title": "Open Second Brain Feature Catalog Area v1",
  "description": "One area file of docs/catalog/: an area and its features. docs/catalog/_removed.json follows $defs.removed_file.",
  "type": "object",
  "required": ["area", "name", "summary", "features"],
  "additionalProperties": false,
  "properties": {
    "area": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "slug": {
      "description": "Flat lowercase kebab-case. Never renamed and never reused.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "line": {
      "type": "string",
      "minLength": 1
    },
    "repo_path": {
      "description": "A repository-relative path with forward slashes: no leading slash, no drive letter, no backslash, no parent segment.",
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.\\.(/|$))[^#\\s\\\\]+$"
    },
    "doc_ref": {
      "description": "A repository-relative doc path as repo_path, with an optional #anchor.",
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.\\.(/|$))[^#\\s\\\\]+(#[^#\\s\\\\]+)?$"
    },
    "surface_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "summary",
        "status",
        "capabilities",
        "limits",
        "surfaces",
        "docs",
        "code",
        "keywords"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["stable", "experimental", "optional", "deprecated"]
        },
        "aliases": {
          "description": "Former slugs or names of this feature.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "capabilities": {
          "description": "One behavior per line.",
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "limits": {
          "description": "Neutral facts of scope that are already true.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "surfaces": {
          "description": "A key is omitted when its list would be empty.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cli": {
              "$ref": "#/$defs/surface_list"
            },
            "mcp": {
              "$ref": "#/$defs/surface_list"
            },
            "hooks": {
              "$ref": "#/$defs/surface_list"
            },
            "skills": {
              "$ref": "#/$defs/surface_list"
            },
            "config": {
              "$ref": "#/$defs/surface_list"
            }
          }
        },
        "docs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/doc_ref"
          }
        },
        "code": {
          "description": "Entry points of the feature in the code.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repo_path"
          }
        },
        "keywords": {
          "description": "Words outsiders use for this feature, the most useful first.",
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    },
    "removed_file": {
      "type": "object",
      "required": ["features"],
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/removed_feature"
          }
        }
      }
    },
    "removed_feature": {
      "type": "object",
      "required": ["slug", "name", "status", "replaced_by"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["removed", "merged"]
        },
        "replaced_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    }
  }
}
