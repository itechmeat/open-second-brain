{
  "name": "open-second-brain",
  "version": "1.72.0",
  "description": "Plugin-first second brain package for AI agents and humans.",
  "author": {
    "name": "Open Second Brain contributors"
  },
  "license": "MIT",
  "homepage": "https://github.com/itechmeat/open-second-brain",
  "repository": "https://github.com/itechmeat/open-second-brain",
  "keywords": ["second-brain", "obsidian", "agents", "skills", "event-log", "mcp"],
  "mcpServers": {
    "open-second-brain": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/o2b",
      "args": ["mcp", "--harness", "claude-code"]
    },
    "open-second-brain-writer": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/o2b",
      "args": ["mcp", "--scope", "writer", "--harness", "claude-code"],
      "alwaysLoad": true
    }
  }
}
